# Private server runtime environment (set in the hosting environment or shell).
# Never use a VITE_ prefix for secrets.
# PRIVATE_ACCESS_CODE=279279
# PRIVATE_DATA_DIR=/persistent/porto-sol
# COOKIE_SECURE=true
# HOST=0.0.0.0
# PORT=8788

# Groq decisions and chat; loaded from .env by the private server.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional backup provider; server-only.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Vercel server-side proxy to the Render private game server.
# PRIVATE_SERVER_URL=https://your-service.onrender.com
