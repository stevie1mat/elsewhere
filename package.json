{
  "name": "elsewhere-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm start",
    "build": "vite build",
    "preview": "npm start",
    "test": "node --test tests/*.test.js",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:apk": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "private": "npm start",
    "start": "npm run build && node server/private.js",
    "groq:check": "node scripts/check-groq.js",
    "ai:mac": "node scripts/mac-ai-worker.js",
    "ai:local:check": "node scripts/check-local-ai.js",
    "training:preview": "npm run build && node scripts/preview-training.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "8.0.13"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
